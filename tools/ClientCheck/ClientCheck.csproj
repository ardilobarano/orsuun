<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the Unity client scripts against the editor's managed assemblies so a type error shows up
       without opening Unity. Not a runtime build: dotnet build tools/ClientCheck -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\6000.0.32f1\Editor\Data\Managed\UnityEngine</UnityManaged>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\client\Assets\Orsuun\Scripts\**\*.cs" />
    <ProjectReference Include="..\..\src\Orsuun.Rules\Orsuun.Rules.csproj" />
    <Reference Include="$(UnityManaged)\UnityEngine.CoreModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.UIModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.UnityWebRequestModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.AudioModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.JSONSerializeModule.dll" />
    <Reference Include="..\..\client\Library\ScriptAssemblies\UnityEngine.UI.dll" />
  </ItemGroup>

</Project>
