<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the Unity client scripts against the editor's managed assemblies so a type error shows up
       without opening Unity. Not a runtime build: dotnet build tools/ClientCheck -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Override with -p:UnityVersion=... or -p:UnityManaged=... when the editor lives elsewhere. -->
    <UnityVersion Condition="'$(UnityVersion)' == ''">6000.0.32f1</UnityVersion>
    <!-- macOS: 6000.0 keeps the assemblies under Contents/Managed, 6000.6+ under Contents/Resources/Scripting/Managed. -->
    <UnityManaged Condition="'$(UnityManaged)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And Exists('/Applications/Unity/Hub/Editor/$(UnityVersion)/Unity.app/Contents/Managed/UnityEngine')">/Applications/Unity/Hub/Editor/$(UnityVersion)/Unity.app/Contents/Managed/UnityEngine</UnityManaged>
    <UnityManaged Condition="'$(UnityManaged)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">/Applications/Unity/Hub/Editor/$(UnityVersion)/Unity.app/Contents/Resources/Scripting/Managed/UnityEngine</UnityManaged>
    <UnityManaged Condition="'$(UnityManaged)' == ''">C:\Program Files\Unity\Hub\Editor\$(UnityVersion)\Editor\Data\Managed\UnityEngine</UnityManaged>
    <!-- UnityEngine.UI.dll is generated once the editor has opened client/; point UnityUI elsewhere before that. -->
    <UnityUI Condition="'$(UnityUI)' == ''">..\..\client\Library\ScriptAssemblies\UnityEngine.UI.dll</UnityUI>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\client\Assets\Orsuun\Scripts\**\*.cs" />
    <ProjectReference Include="..\..\src\Orsuun.Rules\Orsuun.Rules.csproj" />
    <Reference Include="$(UnityManaged)\UnityEngine.CoreModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.UIModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.UnityWebRequestModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.AudioModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.JSONSerializeModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.ScreenCaptureModule.dll" />
    <Reference Include="$(UnityManaged)\UnityEngine.ScriptingModule.dll" Condition="Exists('$(UnityManaged)\UnityEngine.ScriptingModule.dll')" />
    <Reference Include="$(UnityUI)" />
    <!-- URP (since 23 Sep 2026): generated into Library/ScriptAssemblies once the editor has compiled the project. -->
    <Reference Include="..\..\client\Library\ScriptAssemblies\Unity.RenderPipelines.Core.Runtime.dll" Condition="Exists('..\..\client\Library\ScriptAssemblies\Unity.RenderPipelines.Core.Runtime.dll')" />
    <Reference Include="..\..\client\Library\ScriptAssemblies\Unity.RenderPipelines.Universal.Runtime.dll" Condition="Exists('..\..\client\Library\ScriptAssemblies\Unity.RenderPipelines.Universal.Runtime.dll')" />
  </ItemGroup>

</Project>
